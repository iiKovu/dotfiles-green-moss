[global]
### Display ###
title = Dunst
class = Dunst
monitor = 0
follow = none

### Geometry ###
width = 360
height = (0, 900)
origin = top-right
offset = (15, 45)
notification_limit = 10
indicate_hidden = true
shrink = no
transparency = 0
gap_size = 10

### Appearance ###
padding = 18
horizontal_padding = 20
text_icon_padding = 14
frame_width = 1

# Colours: ~/.config/dunst/dunstrc.d/50-theme.conf (active preset)
separator_height = 0
separator_color = frame
corner_radius = 12
progress_bar = true
progress_bar_height = 4
progress_bar_frame_width = 0
progress_bar_corner_radius = 2
progress_bar_min_width = 150
progress_bar_max_width = 280

### Text ###
font = Cantarell 13
line_height = 3
markup = full
format = "<span foreground='#ebe1d5'><b>%s</b></span>\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = 10
word_wrap = yes
ellipsize = end
ignore_newline = no
show_indicators = no

### Icons ###
icon_theme = Tela-black-dark, hicolor
icon_position = left
min_icon_size = 32
max_icon_size = 32
icon_corner_radius = 6

### History ###
sticky_history = false
history_length = 30
stack_duplicates = true
hide_duplicate_count = false

### Behavior ###
idle_threshold = 120
sort = yes
browser = zen-browser
always_run_script = true
ignore_dbusclose = false
fullscreen = pushback

### Mouse Actions ###
mouse_left_click = do_action
mouse_middle_click = close_all
mouse_right_click = close_current

### Urgency Levels ###
[urgency_low]
timeout = 3

[urgency_normal]
timeout = 3

[urgency_critical]
timeout = 0

### Per-App Rules ###

[Spotify]
appname = Spotify
timeout = 5
urgency = low

[Discord]
appname = discord
desktop_entry = discord
urgency = normal
timeout = 5

[agent_terminal]
appname = kitty
timeout = 20
fullscreen = show

[agent_codex]
appname = "*[Cc]odex*"
timeout = 20
fullscreen = show

[agent_claude]
appname = "*[Cc]laude*"
timeout = 20
fullscreen = show
